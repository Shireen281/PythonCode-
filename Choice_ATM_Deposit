total_withdrawl = 0
total_deposit = 0
success_count = 0
failed_count = 0
balance = 10000

for i in range (1,6):
        print(f"\nTransaction {i}")
        print("Enter 1 for Deposit")
        print("Enter 2 for Withdrawl")
        print("Enter 3 for check your balance")
        choice =int(input("enter your choice: ")) 
        print("choice",choice)


        if choice == 1:         
        
        
            amount = float(input("Enter your  amount"))

            if amount > 0 :
                success_count = success_count + 1                
                balance = amount + balance
                total_deposit = total_deposit + amount 
                print ("deposited")

            else:
                print("Invalid Deposit amount")

        elif choice == 2:
            amount = float(input("Enter your  amount"))

            if amount > 0 and amount <= balance:            

                withdrawl = -amount

                if withdrawl <= balance:
                    success_count = success_count + 1
                    total_withdrawl = total_withdrawl + withdrawl
                    balance = balance - withdrawl
                    print("We can do the withdrawal")
               
                else:
                    print("Insufficient transsaction")

            else:
                print("failed transaction") 
                failed_count = failed_count + 1

        elif choice == 3:
            print(f"The final balance is:{balance}") 

        else:
            print("Invalid Choice.")  




print(f"The final balance is:{balance}") 
print(f"The total withdrawl is:{total_withdrawl}") 
print(f"There are {success_count} succesfull transaction")
print(f"There are {failed_count} unsuccessfull transaction")

